# Remote service
BIND_HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://relay.example.com
REMOTE_DB_PATH=./data/relay.sqlite
REMOTE_TRANSFER_DIR=./data/transfers
WORKER_ID=primary-windows
WORKER_TOKEN_SHA256=replace-with-lowercase-sha256
WORKER_OFFLINE_AFTER_MS=45000
JOB_TIMEOUT_MS=120000
MAX_JSON_BYTES=1048576
MAX_FILE_BYTES=268435456
TRANSFER_CHUNK_BYTES=1048576

# MCP OAuth resource server
OAUTH_ISSUER=https://identity.example.com/
OAUTH_AUDIENCE=https://relay.example.com
OAUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OAUTH_REQUIRED_SCOPE=mcp:tools
# Local development only. Do not set in production.
MCP_DEV_TOKEN_SHA256=

# Windows worker
RELAY_URL=https://relay.example.com
WORKER_TOKEN=
WORKER_DATA_DIRECTORY=C:\Users\example\chatgpt-machine-mcp
POLL_SECONDS=25
