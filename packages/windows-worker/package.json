{
  "name": "@mcp-worker/windows-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows tool, policy, audit, desktop, and native-helper core for Mcp-worker.",
  "exports": { "./bridge": "./dist/bridge.js" },
  "bin": { "chatgpt-machine-mcp": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts serve",
    "start": "node dist/cli.js serve",
    "setup": "tsx src/cli.ts setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "native:build": "dotnet build native/ChatGptMachine.Native/ChatGptMachine.Native.csproj -c Release",
    "native:publish": "dotnet publish native/ChatGptMachine.Native/ChatGptMachine.Native.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true",
    "smoke:native": "node scripts/native-smoke.mjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": { "esbuild@0.28.2": true }
}
